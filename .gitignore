# ---- Node ----
node_modules/

# ---- Env / secrets ----
# Ignore every .env in every dir, except the committed example template.
.env
.env.*
!.env.example

# ---- macOS / Windows ----
.DS_Store
Thumbs.db
**/.DS_Store

# ---- IDE ----
.idea/
.vscode/

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Hardhat / contracts ----
contracts/artifacts/
contracts/cache/
contracts/typechain-types/
contracts/coverage/
contracts/coverage.json
contracts/deployed.*.json
hardhat-network-dapp-state.json

# ---- Next.js / frontend ----
frontend/.next/
frontend/out/
frontend/build/
frontend/tsconfig.tsbuildinfo

# ---- Prisma / SQLite ----
# Dev databases should never be committed — they leak state between machines
# and balloon the repo. Schema + migrations DO belong in git.
frontend/prisma/*.db
frontend/prisma/*.db-journal

# ---- AI engine (Python) ----
ai-engine/venv/
ai-engine/.venv/
ai-engine/__pycache__/
ai-engine/**/__pycache__/
ai-engine/*.pyc
ai-engine/**/*.pyc
ai-engine/.pytest_cache/
