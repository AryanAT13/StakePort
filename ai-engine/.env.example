# AI engine environment. Copy to .env for local dev; set the same keys in the
# Render dashboard for production.

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# SerpAPI (Google Shopping / search scraping) — https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Production ONLY: comma-separated list of allowed browser origins.
# Leave unset (or "*") for local dev. Example:
#   FRONTEND_ORIGINS=https://stakeport.vercel.app,https://www.stakeport.xyz
FRONTEND_ORIGINS=*
