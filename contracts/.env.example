# Contract deployment credentials. Copy to .env (git-ignored) and fill in.
# ONLY needed for deploying to a public network like Sepolia.

# An RPC endpoint for Sepolia. Free options:
#   Alchemy:  https://dashboard.alchemy.com  (create app → Sepolia → HTTPS URL)
#   Infura:   https://app.infura.io
#   Public:   https://ethereum-sepolia-rpc.publicnode.com  (fine for deploys)
SEPOLIA_RPC_URL=

# Private key of the deployer wallet (a throwaway MetaMask account).
# Fund it with Sepolia test ETH first:
#   https://cloud.google.com/application/web3/faucet/ethereum/sepolia
# NEVER use a wallet that holds real mainnet funds. No 0x prefix needed, but
# it works either way.
DEPLOYER_PRIVATE_KEY=

# Optional — enables `npx hardhat verify` to publish source to Etherscan.
# https://etherscan.io/myapikey
ETHERSCAN_API_KEY=
