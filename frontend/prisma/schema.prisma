// StakePort persistence layer.
//
// Production: PostgreSQL (Neon / Supabase free tier). The schema was authored
// Postgres-clean from day one, so the only change from the old SQLite setup is
// the datasource block below.
//
// Serverless note: on Vercel, every lambda opens its own DB connection, which
// exhausts a raw Postgres pool fast. We connect through the provider's POOLED
// url (`DATABASE_URL`, pgbouncer) for queries and a DIRECT url (`DIRECT_URL`)
// for migrations / db push, which pgbouncer can't do in transaction mode.

generator client {
  provider      = "prisma-client-js"
  // Vercel/AWS Lambda runs on RHEL+OpenSSL 3; bundling that engine target
  // avoids "Query engine binary not found" at runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// One row per connected wallet. We treat the lowercased EVM address as the
// natural key — `id` (cuid) is only used for foreign keys so we never leak
// addresses into URLs unintentionally.
model User {
  id            String    @id @default(cuid())
  walletAddress String    @unique
  displayName   String?
  avatarUrl     String?
  ageConfirmed  Boolean   @default(false)
  interests     String?   // JSON-encoded string[] — kept as text for portability
  riskProfile   String?   // 'conservative' | 'moderate' | 'aggressive'
  onboardedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  trades        Trade[]

  @@index([walletAddress])
}

// Cache for expensive AI / oracle calls keyed by the asset's deployed contract
// address. Prospectus rarely changes (regenerate manually if seller edits
// metadata); fair value has a TTL we honour in the API route, not the DB.
model AssetMetadata {
  id                String    @id @default(cuid())
  contractAddress   String    @unique
  name              String
  symbol            String?
  // --- AI prospectus (Gemini multimodal) ---
  prospectus        String?
  prospectusModel   String?
  prospectusAt      DateTime?
  // --- ML fair-value oracle (Isolation Forest + SerpAPI) ---
  fairValue         Float?
  fairValueCategory String?
  fairValueStatus   String?
  fairValueRaw      String?   // full JSON snapshot for audit / debugging
  fairValueAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([contractAddress])
}

// We index every Traded event into the DB so portfolio P&L can be calculated
// without re-scanning the chain on every page load. Writes are idempotent on
// txHash so re-running an indexer is safe.
model Trade {
  id              String   @id @default(cuid())
  userId          String?  // null = wallet we haven't seen a profile for yet
  user            User?    @relation(fields: [userId], references: [id])
  walletAddress   String
  contractAddress String
  txHash          String   @unique
  action          String   // 'BUY' | 'SELL'
  tokenAmount     String   // decimal string — bigint-safe across JSON
  usdcAmount      String
  priceAfter      String
  blockNumber     Int
  timestamp       DateTime
  createdAt       DateTime @default(now())

  @@index([walletAddress])
  @@index([contractAddress])
}

// Short-lived SIWE nonces. We delete on use; a sweep job can prune anything
// older than ~10 minutes.
model AuthNonce {
  nonce     String   @id
  createdAt DateTime @default(now())
}
